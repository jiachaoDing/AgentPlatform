{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc -b ../../packages/api && tsdown",
    "check-types": "tsc -b ../../packages/api && tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.mjs",
    "admin:create": "tsx src/bootstrap-admin.ts",
    "test:model:live": "tsx --env-file-if-exists=.env.model.local ../../packages/api/test/model-live.ts"
  },
  "dependencies": {
    "@agent-platform/api": "workspace:*",
    "@agent-platform/auth": "workspace:*",
    "@agent-platform/db": "workspace:*",
    "@fastify/cors": "11.4.1",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "better-auth": "catalog:",
    "fastify": "5.12.8",
    "zod": "catalog:",
    "dotenv": "17.2.3"
  },
  "devDependencies": {
    "@agent-platform/config": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "0.23.7",
    "tsx": "4.23.15",
    "typescript": "catalog:"
  }
}
