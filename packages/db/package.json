{
  "name": "@agent-platform/db",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "check-types": "tsc -b",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate:deploy": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "db:start": "docker compose --env-file ../../apps/server/.env up -d",
    "db:watch": "docker compose --env-file ../../apps/server/.env up",
    "db:stop": "docker compose --env-file ../../apps/server/.env stop",
    "db:down": "docker compose --env-file ../../apps/server/.env down"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "pg": "8.23.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@agent-platform/config": "workspace:*",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "typescript": "catalog:",
    "dotenv": "17.2.3"
  }
}
